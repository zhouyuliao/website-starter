<view class="page">
  <view class="page-head">
    <view class="head-tag">报价资料</view>
    <view class="form-title">完善资料，开始询价</view>
    <view class="form-desc">请填写联系信息、业务身份和位置，用于报价对接与站点匹配。</view>
  </view>
  <view class="form">
    <view class="field"><text class="field-label">联系人姓名 <text>*</text></text><input value="{{name}}" data-field="name" bindinput="onInput" maxlength="12" placeholder="请输入联系人姓名" class="input {{errors.name ? 'input-error' : ''}}"/><text wx:if="{{errors.name}}" class="error">{{errors.name}}</text></view>
    <view class="field"><text class="field-label">手机号码 <text>*</text></text><view class="phone-row {{errors.phone ? 'input-error' : ''}}"><text>+86</text><input type="number" value="{{phone}}" data-field="phone" bindinput="onInput" maxlength="11" placeholder="请输入 11 位手机号码"/></view><text wx:if="{{errors.phone}}" class="error">{{errors.phone}}</text></view>
    <view class="field">
      <text class="field-label">当前身份 <text>*</text></text>
      <view class="role-list">
        <button wx:for="{{roleOptions}}" wx:key="*this" class="role-option {{role === item ? 'role-active' : ''}}" data-value="{{item}}" bindtap="chooseRole">{{item}}</button>
        <button class="role-option {{role === '自定义' ? 'role-active' : ''}}" data-value="自定义" bindtap="chooseRole">自定义</button>
      </view>
      <input wx:if="{{role === '自定义'}}" value="{{customRole}}" data-field="customRole" bindinput="onInput" maxlength="12" placeholder="请输入当前身份" class="input custom-role {{errors.role ? 'input-error' : ''}}"/>
      <text wx:if="{{errors.role}}" class="error">{{errors.role}}</text>
    </view>
    <view class="field">
      <text class="field-label">搅拌站位置 <text>*</text></text>
      <button class="location-button" bindtap="useLocation" loading="{{locating}}">⌖ {{location ? '已获取当前位置，重新获取' : '授权获取当前位置'}}</button>
      <view wx:if="{{locationText}}" class="location-result">✓ {{locationText}}</view>
      <text class="location-divider">或自行填写位置</text>
      <textarea value="{{address}}" data-field="address" bindinput="onInput" maxlength="60" placeholder="请输入省、市、区和详细位置" class="address-input {{errors.address ? 'input-error' : ''}}"/>
      <text wx:if="{{errors.address}}" class="error">{{errors.address}}</text>
    </view>
    <button class="primary-button" bindtap="submit">完成注册，进入首页</button>
  </view>
</view>
