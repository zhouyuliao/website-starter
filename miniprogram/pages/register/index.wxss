.step { padding: 34rpx 40rpx 0; font-size: 22rpx; }.step-label { color: #ea580c; font-weight: 700; letter-spacing: 2rpx; }.step-copy { float: right; color: #6e6860; }.progress { display: flex; gap: 10rpx; margin-top: 18rpx; }.progress view { flex: 1; height: 8rpx; background: #ea580c; }.identity-banner { margin: 32rpx 40rpx 0; padding: 26rpx; background: #1b1917; color: #fff; display: flex; align-items: center; }.identity-banner-icon { height: 64rpx; width: 64rpx; line-height: 64rpx; text-align: center; background: rgba(234,88,12,.2); color: #facc15; font-weight: 700; }.identity-banner view:last-child { margin-left: 18rpx; }.current-label { display: block; color: rgba(255,255,255,.55); font-size: 20rpx; }.current-name { font-size: 28rpx; font-weight: 700; }.form { padding: 38rpx 40rpx; }.form-title { font-size: 36rpx; font-weight: 800; }.form-desc { margin-top: 10rpx; color: #6e6860; font-size: 24rpx; }.field { margin-top: 34rpx; }.field-label { display: block; margin-bottom: 14rpx; font-size: 24rpx; font-weight: 700; }.field-label text { color: #ea580c; }.input, .phone-row, .address-input { box-sizing: border-box; width: 100%; min-height: 88rpx; padding: 0 22rpx; border: 1rpx solid #e2ded6; background: #fff; font-size: 28rpx; }.phone-row { display: flex; align-items: center; padding: 0; }.phone-row text { padding: 0 22rpx; border-right: 1rpx solid #e2ded6; }.phone-row input { flex: 1; height: 86rpx; padding: 0 22rpx; }.input-error { border-color: #dc2626; }.error { display: block; margin-top: 10rpx; color: #dc2626; font-size: 22rpx; }.address-option { margin: 12rpx 0 0; padding: 20rpx; width: 100%; background: #fff; border: 1rpx solid #e2ded6; display: flex; gap: 16rpx; text-align: left; font-size: 25rpx; }.address-option text:nth-child(2) { flex: 1; }.address-active { border-color: #ea580c; background: #fff7f3; font-weight: 700; }.option-check { color: #ea580c; }.address-input { margin-top: 12rpx; padding: 18rpx 22rpx; height: 120rpx; }.primary-button { margin-top: 40rpx; }
