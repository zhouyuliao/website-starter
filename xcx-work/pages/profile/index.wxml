<view class="page">
  <view class="dark-header profile-header"><view class="avatar">{{profile.name ? profile.name[0] : '砼'}}</view><view><view class="profile-name">{{profile.name || '砼友'}} <text class="verified">✓ {{roleName}}</text></view><view class="profile-meta">☎ {{profile.phone || '未绑定手机'}}</view><view class="profile-meta">⌖ {{profile.address || '已使用授权位置'}}</view></view></view>
  <view class="stats card"><view wx:for="{{stats}}" wx:key="label" class="stat"><view>{{item.value}}<text>{{item.unit}}</text></view><text>{{item.label}}</text></view></view>
  <view class="section"><button class="secondary-button" bindtap="openSheet" data-sheet="edit">✎　编辑资料</button></view>
  <view class="section menu card"><button bindtap="openSheet" data-sheet="notice"><text>消息通知</text><text class="badge">3</text><text>›</text></button><button bindtap="goQuotes"><text>我的报价</text><text class="menu-hint">快捷切换</text><text>›</text></button><button bindtap="showComingSoon" data-label="账户设置"><text>账户设置</text><text></text><text>›</text></button><button bindtap="resetProfile"><text>重新完善资料</text><text class="menu-hint">{{roleName}}</text><text>›</text></button><button bindtap="showComingSoon" data-label="帮助与反馈"><text>帮助与反馈</text><text></text><text>›</text></button><button bindtap="showComingSoon" data-label="关于我们"><text>关于我们</text><text class="menu-hint">版本 1.0.0</text><text>›</text></button></view>
  <view class="section"><button class="logout" bindtap="logout">退出登录</button></view>
  <view wx:if="{{sheet}}" class="mask" bindtap="closeSheet"></view>
  <view wx:if="{{sheet === 'edit'}}" class="sheet"><view class="sheet-bar"></view><view class="sheet-content"><view class="sheet-heading"><text>编辑资料</text><button bindtap="closeSheet">×</button></view><view class="field"><text class="field-label">联系人姓名 *</text><input value="{{editName}}" data-field="editName" bindinput="onInput" class="input {{errors.name ? 'input-error' : ''}}"/><text wx:if="{{errors.name}}" class="error">{{errors.name}}</text></view><view class="field"><text class="field-label">手机号码 *</text><input type="number" value="{{editPhone}}" data-field="editPhone" bindinput="onInput" maxlength="11" class="input {{errors.phone ? 'input-error' : ''}}"/><text wx:if="{{errors.phone}}" class="error">{{errors.phone}}</text></view><view class="field"><text class="field-label">当前身份 *</text><view class="role-list"><button wx:for="{{roleOptions}}" wx:key="*this" class="role-option {{editRole === item ? 'role-active' : ''}}" data-value="{{item}}" bindtap="chooseEditRole">{{item}}</button><button class="role-option {{editRole === '自定义' ? 'role-active' : ''}}" data-value="自定义" bindtap="chooseEditRole">自定义</button></view><input wx:if="{{editRole === '自定义'}}" value="{{customRole}}" data-field="customRole" bindinput="onInput" maxlength="12" placeholder="请输入当前身份" class="input custom-role"/><text wx:if="{{errors.role}}" class="error">{{errors.role}}</text></view><view class="field"><text class="field-label">搅拌站位置 *</text><button class="location-button" bindtap="useLocation" loading="{{locating}}">⌖ {{editLocation ? '重新获取当前位置' : '授权获取当前位置'}}</button><view wx:if="{{locationText}}" class="location-result">✓ {{locationText}}</view><text class="location-divider">或自行填写位置</text><textarea value="{{editAddress}}" data-field="editAddress" bindinput="onInput" maxlength="60" placeholder="请输入省、市、区和详细位置" class="address-input"/><text wx:if="{{errors.address}}" class="error">{{errors.address}}</text></view><button class="primary-button" bindtap="save">保存修改</button></view></view>
  <view wx:if="{{sheet === 'notice'}}" class="sheet"><view class="sheet-bar"></view><view class="sheet-content"><view class="sheet-heading"><text>消息通知</text><button bindtap="closeSheet">×</button></view><view wx:for="{{notifications}}" wx:key="id" class="notice"><view><text class="tag">{{item.type}}</text><text class="notice-time">{{item.time}}</text></view><view class="notice-title">{{item.title}}</view><view class="subtle">{{item.desc}}</view></view></view></view>
</view>
