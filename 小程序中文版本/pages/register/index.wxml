<view class="page">
  <view class="step"><view><text class="step-label">步骤 2/2</text><text class="step-copy">填写联系人信息</text></view><view class="progress"><view></view><view></view></view></view>
  <view class="identity-banner" wx:if="{{identity}}"><view class="identity-banner-icon">{{identity.icon}}</view><view><text class="current-label">当前身份</text><text class="current-name">{{identity.name}}</text></view></view>
  <view class="form"><view class="form-title">请填写以下信息</view><view class="form-desc">信息仅用于报价对接与站点匹配。</view>
    <view class="field"><text class="field-label">联系人姓名 <text>*</text></text><input value="{{name}}" data-field="name" bindinput="onInput" maxlength="12" placeholder="请输入联系人姓名" class="input {{errors.name ? 'input-error' : ''}}"/><text wx:if="{{errors.name}}" class="error">{{errors.name}}</text></view>
    <view class="field"><text class="field-label">手机号码 <text>*</text></text><view class="phone-row {{errors.phone ? 'input-error' : ''}}"><text>+86</text><input type="number" value="{{phone}}" data-field="phone" bindinput="onInput" maxlength="11" placeholder="请输入 11 位手机号码"/></view><text wx:if="{{errors.phone}}" class="error">{{errors.phone}}</text></view>
    <view class="field"><text class="field-label">搅拌站地址 <text>*</text></text><button wx:for="{{presetAddresses}}" wx:key="*this" class="address-option {{addressKey === item ? 'address-active' : ''}}" data-value="{{item}}" bindtap="chooseAddress"><text>⌖</text><text>{{item}}</text><text class="option-check">{{addressKey === item ? '✓' : ''}}</text></button><button class="address-option {{addressKey === 'custom' ? 'address-active' : ''}}" data-value="custom" bindtap="chooseAddress"><text>✎</text><text>自定义地址</text><text class="option-check">{{addressKey === 'custom' ? '✓' : ''}}</text></button><textarea wx:if="{{addressKey === 'custom'}}" value="{{customAddress}}" data-field="customAddress" bindinput="onInput" maxlength="60" placeholder="请输入省、市、区和详细位置" class="address-input"/><text wx:if="{{errors.address}}" class="error">{{errors.address}}</text></view>
    <button class="primary-button" bindtap="submit">完成注册，进入首页</button>
  </view>
</view>
