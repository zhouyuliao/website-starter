<view class="page">
  <view class="dark-header profile-header"><view class="avatar">{{profile.name ? profile.name[0] : '砼'}}</view><view><view class="profile-name">{{profile.name || '砼友'}} <text class="verified">✓ {{identity.name}}</text></view><view class="profile-meta">☎ {{profile.phone || '未绑定手机'}}</view><view class="profile-meta">⌖ {{profile.address || '未设置搅拌站地址'}}</view></view></view>
  <view class="stats card"><view wx:for="{{stats}}" wx:key="label" class="stat"><view>{{item.value}}<text>{{item.unit}}</text></view><text>{{item.label}}</text></view></view>
  <view class="section"><button class="secondary-button" bindtap="openSheet" data-sheet="edit">✎　编辑资料</button></view>
  <view class="section menu card"><button bindtap="openSheet" data-sheet="notice"><text>消息通知</text><text class="badge">3</text><text>›</text></button><button bindtap="goQuotes"><text>我的报价</text><text class="menu-hint">快捷切换</text><text>›</text></button><button bindtap="showComingSoon" data-label="账户设置"><text>账户设置</text><text></text><text>›</text></button><button bindtap="switchIdentity"><text>切换身份</text><text class="menu-hint">{{identity.name}}</text><text>›</text></button><button bindtap="showComingSoon" data-label="帮助与反馈"><text>帮助与反馈</text><text></text><text>›</text></button><button bindtap="showComingSoon" data-label="关于我们"><text>关于我们</text><text class="menu-hint">v1.0.0</text><text>›</text></button></view>
  <view class="section"><button class="logout" bindtap="logout">退出登录</button></view>
  <view wx:if="{{sheet}}" class="mask" bindtap="closeSheet"></view>
  <view wx:if="{{sheet === 'edit'}}" class="sheet"><view class="sheet-bar"></view><view class="sheet-content"><view class="sheet-heading"><text>编辑资料</text><button bindtap="closeSheet">×</button></view><view class="field"><text class="field-label">联系人姓名 *</text><input value="{{editName}}" data-field="editName" bindinput="onInput" class="input {{errors.name ? 'input-error' : ''}}"/><text wx:if="{{errors.name}}" class="error">{{errors.name}}</text></view><view class="field"><text class="field-label">手机号码 *</text><input type="number" value="{{editPhone}}" data-field="editPhone" bindinput="onInput" maxlength="11" class="input {{errors.phone ? 'input-error' : ''}}"/><text wx:if="{{errors.phone}}" class="error">{{errors.phone}}</text></view><view class="field"><text class="field-label">搅拌站地址 *</text><button wx:for="{{presetAddresses}}" wx:key="*this" class="address-option {{editAddress === item ? 'address-active' : ''}}" data-value="{{item}}" bindtap="chooseAddress">{{item}}　{{editAddress === item ? '✓' : ''}}</button><textarea value="{{editAddress}}" data-field="editAddress" bindinput="onInput" maxlength="60" class="address-input"/><text wx:if="{{errors.address}}" class="error">{{errors.address}}</text></view><button class="primary-button" bindtap="save">保存修改</button></view></view>
  <view wx:if="{{sheet === 'notice'}}" class="sheet"><view class="sheet-bar"></view><view class="sheet-content"><view class="sheet-heading"><text>消息通知</text><button bindtap="closeSheet">×</button></view><view wx:for="{{notifications}}" wx:key="id" class="notice"><view><text class="tag">{{item.type}}</text><text class="notice-time">{{item.time}}</text></view><view class="notice-title">{{item.title}}</view><view class="subtle">{{item.desc}}</view></view></view></view>
</view>
