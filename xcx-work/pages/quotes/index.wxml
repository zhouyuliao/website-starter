<view class="page">
  <view class="dark-header"><view class="page-title">报价中心</view><view class="dark-subtle">查看本周与本月的最新报价信息</view></view>
  <view class="summary"><view class="summary-card"><text>本周 C30 均价</text><view>¥386<text>/方</text></view><text>较上周　<text class="up">+5</text></text></view><view class="summary-card"><text>本月 C30 均价</text><view>¥381<text>/方</text></view><text>较上月　<text class="up">+8</text></text></view></view>
  <view class="filters"><button class="filter {{filter === 'all' ? 'filter-active' : ''}}" data-filter="all" bindtap="selectFilter">全部</button><button class="filter {{filter === 'week' ? 'filter-active' : ''}}" data-filter="week" bindtap="selectFilter">本周</button><button class="filter {{filter === 'month' ? 'filter-active' : ''}}" data-filter="month" bindtap="selectFilter">本月</button><text>共 {{quotes.length}} 条</text></view>
  <view class="quote-list"><button wx:for="{{quotes}}" wx:key="id" class="quote-card" data-id="{{item.id}}" bindtap="openDetail"><view class="grade">{{item.grade}}</view><view class="quote-copy"><text>{{item.station}}</text><text>◷ {{item.time}}</text></view><view class="price">¥{{item.price}}<text>/方</text><text class="{{item.change > 0 ? 'up' : item.change < 0 ? 'down' : 'flat'}}">{{item.change > 0 ? '+' : ''}}{{item.change === 0 ? '持平' : item.change}}</text></view></button></view>
  <view wx:if="{{active}}" class="mask" bindtap="closeDetail"></view><view wx:if="{{active}}" class="sheet"><view class="sheet-bar"></view><view class="sheet-content"><view class="sheet-top"><view><view class="detail-grade">{{active.grade}}</view><view class="detail-station">{{active.station}}</view><text class="subtle">最新报价 · {{active.time}}</text></view><button class="close" bindtap="closeDetail">×</button></view><view class="price-block"><text>当前报价（含泵送）</text><view>¥{{active.price}}<text>/方</text></view></view><view class="detail-title">报价时间节点</view><view class="history"><view wx:for="{{active.history}}" wx:key="t" class="history-row"><text>{{item.t}}</text><text>¥{{item.p}}/方</text></view></view><view wx:if="{{!submitted}}" class="inquiry"><view class="detail-title">提交询价需求</view><text class="subtle">填写预计用量，便于站点快速响应。</text><text class="label">预计用量（方）</text><input type="number" value="{{quantity}}" data-field="quantity" bindinput="onInput" class="inquiry-input"/><text class="label">备注（选填）</text><textarea value="{{note}}" data-field="note" bindinput="onInput" maxlength="80" placeholder="例如：明日上午 9 点前送达" class="inquiry-note"/><button class="primary-button" bindtap="submit">提交询价需求</button></view><view wx:else class="success"><view>询价需求已记录</view><text>{{active.station}} 会按 {{quantity}} 方的预计用量准备联系。</text><button bindtap="closeDetail">返回报价列表</button></view></view></view>
</view>
