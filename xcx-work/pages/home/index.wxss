.welcome-row { display: flex; align-items: center; }.avatar { height: 80rpx; width: 80rpx; line-height: 80rpx; text-align: center; background: #ea580c; font-size: 34rpx; font-weight: 900; }.welcome-row view:last-child { margin-left: 20rpx; }.welcome { font-size: 31rpx; font-weight: 800; }.verified { display: inline-block; margin-top: 9rpx; padding: 3rpx 10rpx; background: #facc15; color: #1b1917; font-size: 20rpx; font-weight: 700; }.ticker { margin: 26rpx -32rpx -34rpx; overflow: hidden; white-space: nowrap; padding: 14rpx 32rpx; background: #facc15; color: #1b1917; font-size: 21rpx; font-weight: 700; }.intro-wrap { margin-top: 24rpx; }.action-row { display: flex; gap: 20rpx; margin-top: 22rpx; }.primary-action, .dark-action { flex: 1; padding: 23rpx 10rpx; color: #fff; font-size: 27rpx; font-weight: 700; }.primary-action { background: #ea580c; }.dark-action { background: #1b1917; }.title-row { display: flex; justify-content: space-between; align-items: center; }.map-card { margin-top: 20rpx; height: 400rpx; position: relative; border: 1rpx solid #e2ded6; overflow: hidden; }.map { height: 400rpx; width: 100%; }.map-address { position: absolute; left: 16rpx; top: 16rpx; padding: 10rpx 14rpx; max-width: 420rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; background: rgba(27,25,23,.88); color: #fff; font-size: 20rpx; }.station-list { border-top: 0; }.station-row { padding: 24rpx; display: flex; align-items: center; border-top: 1rpx solid #e2ded6; }.distance { min-width: 90rpx; padding: 12rpx 4rpx; background: #f2f1ed; color: #ea580c; text-align: center; font-size: 22rpx; font-weight: 700; }.station-copy { flex: 1; min-width: 0; margin-left: 18rpx; }.station-copy > text { display: block; font-size: 26rpx; font-weight: 700; }.station-copy view { margin-top: 7rpx; color: #6e6860; font-size: 20rpx; }.nav-button { padding: 10rpx 0 10rpx 16rpx; background: transparent; color: #ea580c; font-size: 23rpx; font-weight: 700; }
