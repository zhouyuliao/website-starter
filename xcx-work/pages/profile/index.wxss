.profile-header { display: flex; align-items: center; padding-bottom: 110rpx; }.profile-header .avatar { flex-shrink: 0; width: 104rpx; height: 104rpx; line-height: 104rpx; background: #ea580c; text-align: center; font-size: 42rpx; font-weight: 900; }.profile-header > view:last-child { margin-left: 22rpx; min-width: 0; }.profile-name { font-size: 36rpx; font-weight: 900; }.profile-name .verified { margin-left: 8rpx; padding: 4rpx 9rpx; background: #facc15; color: #1b1917; font-size: 18rpx; }.profile-meta { margin-top: 9rpx; color: rgba(255,255,255,.62); font-size: 22rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }.stats { display: flex; margin: -74rpx 32rpx 0; position: relative; }.stat { flex: 1; padding: 26rpx 8rpx; text-align: center; border-right: 1rpx solid #e2ded6; }.stat:last-child { border: 0; }.stat view { font-size: 36rpx; font-weight: 800; }.stat view text { color: #6e6860; font-size: 19rpx; font-weight: 400; }.stat > text { display: block; margin-top: 10rpx; color: #6e6860; font-size: 20rpx; }.menu button { display: flex; align-items: center; width: 100%; padding: 25rpx; background: #fff; border-bottom: 1rpx solid #e2ded6; text-align: left; font-size: 26rpx; }.menu button text:first-child { flex: 1; }.menu-hint { color: #6e6860; font-size: 20rpx; }.badge { padding: 3rpx 10rpx; background: #ea580c; color: #fff; font-size: 19rpx; }.logout { width: 100%; padding: 24rpx; background: #fff; border: 1rpx solid #e2ded6; color: #6e6860; font-size: 27rpx; }.mask { position: fixed; z-index: 10; inset: 0; background: rgba(27,25,23,.65); }.sheet { position: fixed; z-index: 11; bottom: 0; left: 0; right: 0; max-height: 85vh; overflow-y: auto; background: #f2f1ed; }.sheet-bar { height: 10rpx; background: repeating-linear-gradient(-45deg,#facc15 0,#facc15 12rpx,#1b1917 12rpx,#1b1917 24rpx); }.sheet-content { padding: 30rpx 32rpx 46rpx; }.sheet-heading { display: flex; justify-content: space-between; align-items: center; font-size: 30rpx; font-weight: 800; }.sheet-heading button { width: 64rpx; height: 64rpx; padding: 0; background: #e9e6e0; font-size: 42rpx; line-height: 58rpx; }.field { margin-top: 26rpx; }.field-label { display: block; margin-bottom: 12rpx; font-size: 23rpx; font-weight: 700; }.input, .address-input { width: 100%; min-height: 82rpx; box-sizing: border-box; padding: 0 18rpx; background: #fff; border: 1rpx solid #e2ded6; font-size: 26rpx; }.input-error { border-color: #dc2626; }.error { display: block; color: #dc2626; font-size: 20rpx; margin-top: 8rpx; }.address-option { width: 100%; margin-top: 10rpx; padding: 18rpx; background: #fff; border: 1rpx solid #e2ded6; font-size: 23rpx; text-align: left; }.address-active { border-color: #ea580c; background: #fff7f3; }.address-input { height: 106rpx; margin-top: 10rpx; padding-top: 18rpx; }.sheet-content .primary-button { margin-top: 30rpx; }.notice { margin-top: 20rpx; padding: 24rpx; background: #fff; border: 1rpx solid #e2ded6; }.notice-time { float: right; color: #6e6860; font-size: 19rpx; }.notice-title { margin: 16rpx 0 8rpx; font-size: 26rpx; font-weight: 800; }
