.page-head { padding: 44rpx 40rpx 32rpx; background: #1b1917; color: #fff; }
.head-tag { display: inline-block; padding: 5rpx 12rpx; background: #ea580c; font-size: 20rpx; font-weight: 700; }
.form { padding: 10rpx 40rpx 46rpx; }
.form-title { margin-top: 18rpx; font-size: 40rpx; font-weight: 800; }
.form-desc { margin-top: 12rpx; color: rgba(255,255,255,.65); font-size: 24rpx; line-height: 1.6; }
.field { margin-top: 34rpx; }
.field-label { display: block; margin-bottom: 14rpx; font-size: 24rpx; font-weight: 700; }
.field-label text { color: #ea580c; }
.input, .phone-row, .address-input { box-sizing: border-box; width: 100%; min-height: 88rpx; padding: 0 22rpx; border: 1rpx solid #e2ded6; background: #fff; font-size: 28rpx; }
.phone-row { display: flex; align-items: center; padding: 0; }
.phone-row text { padding: 0 22rpx; border-right: 1rpx solid #e2ded6; }
.phone-row input { flex: 1; height: 86rpx; padding: 0 22rpx; }
.input-error { border-color: #dc2626; }
.error { display: block; margin-top: 10rpx; color: #dc2626; font-size: 22rpx; }
.role-list { display: flex; flex-wrap: wrap; gap: 14rpx; }
.role-option { width: calc((100% - 28rpx) / 3); padding: 19rpx 6rpx; background: #fff; border: 1rpx solid #e2ded6; color: #4b4640; font-size: 24rpx; }
.role-active { background: #fff7f3; border-color: #ea580c; color: #c2410c; font-weight: 700; }
.custom-role { margin-top: 14rpx; }
.location-button { width: 100%; padding: 23rpx; background: #1b1917; color: #fff; font-size: 27rpx; font-weight: 700; }
.location-result { margin-top: 12rpx; padding: 16rpx; background: #ecfdf5; color: #047857; font-size: 22rpx; line-height: 1.5; }
.location-divider { display: block; margin: 22rpx 0 10rpx; color: #6e6860; font-size: 22rpx; }
.address-input { padding: 18rpx 22rpx; height: 120rpx; }
.primary-button { margin-top: 40rpx; }
