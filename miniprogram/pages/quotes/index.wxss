.summary { display: flex; gap: 18rpx; margin: -26rpx 32rpx 0; position: relative; }.summary-card { flex: 1; padding: 24rpx; background: #fff; border: 1rpx solid #e2ded6; }.summary-card > text { display: block; color: #6e6860; font-size: 20rpx; }.summary-card > view { margin: 12rpx 0; font-size: 44rpx; font-weight: 800; }.summary-card > view text, .price text, .price-block view text { margin-left: 3rpx; color: #6e6860; font-size: 20rpx; font-weight: 400; }.up { color: #dc2626 !important; }.down { color: #059669 !important; }.flat { color: #6e6860 !important; }.filters { display: flex; align-items: center; gap: 14rpx; margin: 34rpx 32rpx 0; }.filter { padding: 12rpx 22rpx; background: #fff; border: 1rpx solid #e2ded6; color: #6e6860; font-size: 23rpx; }.filter-active { background: #1b1917; border-color: #1b1917; color: #facc15; }.filters text { flex: 1; text-align: right; color: #6e6860; font-size: 21rpx; }.quote-list { margin: 20rpx 32rpx; }.quote-card { display: flex; align-items: center; width: 100%; margin-bottom: 16rpx; padding: 24rpx; background: #fff; border: 1rpx solid #e2ded6; text-align: left; }.grade, .detail-grade { padding: 18rpx 14rpx; min-width: 56rpx; background: #1b1917; color: #facc15; font-size: 27rpx; font-weight: 800; text-align: center; }.quote-copy { flex: 1; margin-left: 20rpx; }.quote-copy text:first-child { display: block; font-size: 27rpx; font-weight: 700; }.quote-copy text:last-child { display: block; margin-top: 9rpx; color: #6e6860; font-size: 20rpx; }.price { text-align: right; font-size: 31rpx; font-weight: 800; }.price > text:last-child { display: block; margin-top: 8rpx; font-size: 21rpx; }.mask { position: fixed; inset: 0; z-index: 10; background: rgba(27,25,23,.65); }.sheet { position: fixed; z-index: 11; left: 0; right: 0; bottom: 0; max-height: 86vh; overflow-y: auto; background: #f2f1ed; }.sheet-bar { height: 10rpx; background: repeating-linear-gradient(-45deg,#facc15 0,#facc15 12rpx,#1b1917 12rpx,#1b1917 24rpx); }.sheet-content { padding: 30rpx 32rpx 46rpx; }.sheet-top { display: flex; justify-content: space-between; }.sheet-top > view { display: flex; align-items: center; gap: 16rpx; flex-wrap: wrap; }.detail-station { font-size: 29rpx; font-weight: 800; }.close { width: 64rpx; height: 64rpx; padding: 0; background: #e9e6e0; font-size: 42rpx; line-height: 58rpx; }.price-block { margin-top: 28rpx; padding: 24rpx; background: #1b1917; color: rgba(255,255,255,.55); font-size: 20rpx; }.price-block view { margin-top: 10rpx; color: #facc15; font-size: 54rpx; font-weight: 800; }.detail-title { margin-top: 32rpx; font-size: 27rpx; font-weight: 800; }.history { margin-top: 16rpx; background: #fff; border: 1rpx solid #e2ded6; }.history-row { display: flex; justify-content: space-between; padding: 20rpx; border-bottom: 1rpx solid #e2ded6; color: #6e6860; font-size: 23rpx; }.history-row text:last-child { color: #1b1917; font-weight: 700; }.label { display: block; margin: 22rpx 0 10rpx; font-size: 23rpx; font-weight: 700; }.inquiry-input, .inquiry-note { box-sizing: border-box; width: 100%; background: #fff; border: 1rpx solid #e2ded6; padding: 20rpx; font-size: 26rpx; }.inquiry-note { height: 110rpx; }.inquiry .primary-button { margin-top: 22rpx; }.success { margin-top: 32rpx; padding: 26rpx; background: #ecfdf5; border: 1rpx solid #a7f3d0; color: #047857; }.success view { font-size: 28rpx; font-weight: 800; }.success text { display: block; margin-top: 10rpx; font-size: 22rpx; }.success button { margin-top: 18rpx; padding: 0; background: transparent; color: #047857; font-size: 23rpx; text-align: left; }
