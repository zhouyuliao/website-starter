page {
  background: #f2f1ed;
  color: #1b1917;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}
button { border: 0; border-radius: 0; line-height: inherit; }
button::after { border: 0; }
.page { min-height: 100vh; box-sizing: border-box; padding-bottom: 36rpx; }
.dark-header { background: #1b1917; color: #fff; padding: 28rpx 32rpx 34rpx; }
.page-title { font-size: 38rpx; font-weight: 800; }
.subtle { color: #6e6860; font-size: 24rpx; line-height: 1.6; }
.dark-subtle { color: rgba(255,255,255,.62); font-size: 24rpx; line-height: 1.6; }
.section { margin: 30rpx 32rpx 0; }
.section-title { display: flex; align-items: center; font-size: 32rpx; font-weight: 800; }
.section-title::before { content: ""; display: block; width: 8rpx; height: 28rpx; margin-right: 16rpx; background: #ea580c; }
.card { background: #fff; border: 1rpx solid #e2ded6; }
.primary-button { background: #ea580c; color: #fff; font-size: 30rpx; font-weight: 700; padding: 26rpx 24rpx; }
.secondary-button { background: #1b1917; color: #fff; font-size: 28rpx; font-weight: 700; padding: 22rpx 24rpx; }
.danger-text { color: #dc2626; font-size: 22rpx; margin-top: 12rpx; }
.tag { display: inline-flex; align-items: center; background: #fff1eb; color: #c2410c; padding: 4rpx 12rpx; font-size: 20rpx; font-weight: 700; }
.status-good { color: #059669; }
.status-warn { color: #ea580c; }
.row { display: flex; align-items: center; }
.role-list { display: flex; flex-wrap: wrap; gap: 10rpx; }
.role-option { width: calc((100% - 20rpx) / 3); padding: 16rpx 4rpx; background: #fff; border: 1rpx solid #e2ded6; color: #4b4640; font-size: 22rpx; }
.role-active { background: #fff7f3; border-color: #ea580c; color: #c2410c; font-weight: 700; }
.custom-role { margin-top: 10rpx; }
.location-button { width: 100%; padding: 20rpx; background: #1b1917; color: #fff; font-size: 24rpx; font-weight: 700; }
.location-result { margin-top: 10rpx; padding: 14rpx; background: #ecfdf5; color: #047857; font-size: 20rpx; line-height: 1.5; }
.location-divider { display: block; margin: 18rpx 0 8rpx; color: #6e6860; font-size: 20rpx; }
