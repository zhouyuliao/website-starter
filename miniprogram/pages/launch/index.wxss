.launch-page { background: #1b1917; min-height: 100vh; color: #fff; }
.hero { height: 430rpx; position: relative; overflow: hidden; }
.hero-image, .hero-mask { width: 100%; height: 100%; position: absolute; inset: 0; }
.hero-mask { background: linear-gradient(0deg, #1b1917 0%, rgba(27,25,23,.18) 60%, rgba(27,25,23,.55) 100%); }
.hero-copy { position: absolute; left: 40rpx; right: 40rpx; bottom: 34rpx; }
.brand-row { display: flex; align-items: center; gap: 18rpx; }
.brand-tag { background: #ea580c; padding: 5rpx 12rpx; font-size: 20rpx; font-weight: 700; letter-spacing: 3rpx; }
.brand-en { color: rgba(255,255,255,.6); font-size: 20rpx; letter-spacing: 4rpx; }
.hero-title { margin-top: 18rpx; font-size: 52rpx; font-weight: 900; }
.hazard { height: 14rpx; background: repeating-linear-gradient(-45deg, #facc15 0, #facc15 14rpx, #1b1917 14rpx, #1b1917 28rpx); }
.content { padding: 34rpx 40rpx 48rpx; }
.intro { color: rgba(255,255,255,.62); font-size: 26rpx; line-height: 1.7; }
.identity-list { margin-top: 34rpx; }
.identity-card { margin-bottom: 20rpx; padding: 28rpx; background: #26231f; border: 2rpx solid #3b362f; display: flex; align-items: center; text-align: left; color: #fff; }
.identity-active { border-color: #ea580c; background: rgba(234,88,12,.16); }
.identity-icon { width: 76rpx; height: 76rpx; line-height: 76rpx; text-align: center; background: #3b362f; color: #facc15; font-size: 30rpx; font-weight: 700; }
.identity-active .identity-icon { background: #ea580c; color: #fff; }
.identity-copy { flex: 1; margin-left: 24rpx; }
.identity-name { font-size: 30rpx; font-weight: 700; }
.identity-en { margin-left: 16rpx; color: rgba(255,255,255,.45); font-size: 19rpx; letter-spacing: 3rpx; }
.identity-desc { display: block; margin-top: 8rpx; color: rgba(255,255,255,.55); font-size: 22rpx; line-height: 1.45; }
.radio { width: 34rpx; height: 34rpx; box-sizing: border-box; border: 2rpx solid rgba(255,255,255,.3); border-radius: 50%; text-align: center; line-height: 30rpx; font-size: 20rpx; }
.radio-active { background: #ea580c; border-color: #ea580c; }
.next-button { margin-top: 18rpx; background: #ea580c; color: #fff; font-size: 30rpx; font-weight: 700; padding: 26rpx; }
.next-disabled { background: #3b362f; color: rgba(255,255,255,.4); }
.agreement { margin-top: 28rpx; color: rgba(255,255,255,.35); text-align: center; font-size: 20rpx; }
